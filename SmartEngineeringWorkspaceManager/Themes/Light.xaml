<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Mode Color Palette -->
    <SolidColorBrush x:Key="MainBg" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SidebarBg" Color="#1E1E2F"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#2A2A40"/>
    <SolidColorBrush x:Key="SidebarActive" Color="#3D3D5C"/>
    <SolidColorBrush x:Key="SidebarText" Color="#A0A0B0"/>
    <SolidColorBrush x:Key="SidebarTextHover" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#2D3748"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#718096"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>

    <SolidColorBrush x:Key="BrandBlue" Color="#3182CE"/>
    <SolidColorBrush x:Key="BrandOrange" Color="#DD6B20"/>
    <SolidColorBrush x:Key="BrandGreen" Color="#38A169"/>
    <SolidColorBrush x:Key="DangerRed" Color="#E53E3E"/>

    <!-- Common Shadows -->
    <DropShadowEffect x:Key="CardShadow" Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
</ResourceDictionary>