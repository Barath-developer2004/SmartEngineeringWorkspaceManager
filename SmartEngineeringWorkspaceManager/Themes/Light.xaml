<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Mode Color Palette: Linear/Fluent Inspired -->
    <SolidColorBrush x:Key="MainBg" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SidebarBg" Color="#FAFAFC"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#F1F2F4"/>
    <SolidColorBrush x:Key="SidebarActive" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="SidebarText" Color="#6B7280"/>
    <SolidColorBrush x:Key="SidebarTextHover" Color="#111827"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>

    <SolidColorBrush x:Key="BrandBlue" Color="#4F46E5"/> <!-- Premium Indigo Accent -->
    <SolidColorBrush x:Key="BrandOrange" Color="#F59E0B"/>
    <SolidColorBrush x:Key="BrandGreen" Color="#10B981"/>
    <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>

    <!-- Subtle Floating Shadows -->
    <DropShadowEffect x:Key="CardShadow" Color="#9CA3AF" BlurRadius="20" ShadowDepth="4" Opacity="0.08" Direction="270"/>
    <DropShadowEffect x:Key="HoverShadow" Color="#9CA3AF" BlurRadius="25" ShadowDepth="8" Opacity="0.15" Direction="270"/>
</ResourceDictionary>