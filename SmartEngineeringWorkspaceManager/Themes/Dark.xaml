<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Mode Color Palette -->
    <SolidColorBrush x:Key="MainBg" Color="#121212"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="CardBg" Color="#252526"/>

    <SolidColorBrush x:Key="SidebarBg" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#2A2A2D"/>
    <SolidColorBrush x:Key="SidebarActive" Color="#333333"/>
    <SolidColorBrush x:Key="SidebarText" Color="#8B8B8B"/>
    <SolidColorBrush x:Key="SidebarTextHover" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="BorderColor" Color="#3A3A3A"/>

    <SolidColorBrush x:Key="BrandBlue" Color="#63B3ED"/>
    <SolidColorBrush x:Key="BrandOrange" Color="#F6AD55"/>
    <SolidColorBrush x:Key="BrandGreen" Color="#68D391"/>
    <SolidColorBrush x:Key="DangerRed" Color="#FC8181"/>

    <!-- Common Shadows (Darker for dark mode) -->
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
</ResourceDictionary>