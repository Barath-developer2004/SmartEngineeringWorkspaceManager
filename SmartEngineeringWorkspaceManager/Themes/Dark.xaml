<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Mode Color Palette: Cinematic Charcoal / Linear Inspired -->
    <SolidColorBrush x:Key="MainBg" Color="#0B0D10"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#111418"/>
    <SolidColorBrush x:Key="CardBg" Color="#161A20"/>

    <SolidColorBrush x:Key="SidebarBg" Color="#0B0D10"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#1C2128"/>
    <SolidColorBrush x:Key="SidebarActive" Color="#22272E"/>
    <SolidColorBrush x:Key="SidebarText" Color="#7D8590"/>
    <SolidColorBrush x:Key="SidebarTextHover" Color="#C9D1D9"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#7D8590"/>
    <SolidColorBrush x:Key="BorderColor" Color="#21262D"/>

    <SolidColorBrush x:Key="BrandBlue" Color="#58A6FF"/> <!-- Vibrant Soft Blue -->
    <SolidColorBrush x:Key="BrandOrange" Color="#D29922"/>
    <SolidColorBrush x:Key="BrandGreen" Color="#238636"/>
    <SolidColorBrush x:Key="DangerRed" Color="#DA3633"/>

    <!-- Deep Space Shadows -->
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.25" Direction="270"/>
    <DropShadowEffect x:Key="HoverShadow" Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.45" Direction="270"/>
</ResourceDictionary>