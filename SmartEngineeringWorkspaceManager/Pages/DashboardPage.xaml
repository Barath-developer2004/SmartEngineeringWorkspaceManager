<UserControl x:Class="SmartEngineeringWorkspaceManager.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartEngineeringWorkspaceManager.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Style="{StaticResource FadeInPageStyle}"
             Background="{DynamicResource MainBg}">

    <UserControl.Resources>
        <Style x:Key="ActivityItemStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,16"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
        <StackPanel Margin="24">

            <!-- Dashboard Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1 Cards -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StandardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Projects" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBlock x:Name="txtTotalProjects" Text="0" FontFamily="{StaticResource MainFont}" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource BrandBlue}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StandardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Documents" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBlock x:Name="txtTotalDocuments" Text="0" FontFamily="{StaticResource MainFont}" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource BrandGreen}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource StandardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Active Projects" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBlock x:Name="txtActiveProjects" Text="0" FontFamily="{StaticResource MainFont}" FontSize="42" FontWeight="Bold" Foreground="#805AD5" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Row 2 Cards -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StandardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Pending Tasks" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBlock x:Name="txtPendingTasks" Text="0" FontFamily="{StaticResource MainFont}" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource BrandOrange}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StandardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Completed Tasks" Style="{StaticResource SubHeaderTextStyle}"/>
                        <TextBlock x:Name="txtCompletedTasks" Text="0" FontFamily="{StaticResource MainFont}" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource BrandGreen}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Activity Section -->
            <Border Style="{StaticResource StandardCardStyle}" MinHeight="300">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Recent Activity" Style="{StaticResource HeaderTextStyle}" Margin="0"/>
                        <Button Content="Refresh Dashboard" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource BrandBlue}" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Click="BtnRefresh_Click"/>
                    </Grid>

                    <!-- We replace the hardcoded items with an ItemsControl bound to our DB -->
                    <ItemsControl x:Name="icRecentActivity">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ActivityItemStyle}">
                                    <Grid>
                                        <TextBlock Text="{Binding ActivityDescription}" FontFamily="{StaticResource MainFont}" FontSize="15" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,100,0"/>
                                        <TextBlock Text="{Binding FriendlyTime}" FontFamily="{StaticResource MainFont}" FontSize="14" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="txtNoActivity" Text="No recent activity found." Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" Visibility="Collapsed" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>