<UserControl x:Class="SmartEngineeringWorkspaceManager.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartEngineeringWorkspaceManager.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <FontFamily x:Key="MainFont">Segoe UI, Helvetica Neue, Arial</FontFamily>
        <SolidColorBrush x:Key="TextPrimary" Color="#2D3748"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#718096"/>
        <SolidColorBrush x:Key="BrandBlue" Color="#3182CE"/>
        <SolidColorBrush x:Key="BrandOrange" Color="#DD6B20"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#38A169"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#A0AEC0" BlurRadius="15" Opacity="0.15" ShadowDepth="4" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivityItemStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,16"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
        <StackPanel Margin="24">

            <!-- Dashboard Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1 Cards -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Projects" FontFamily="{StaticResource MainFont}" FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="txtTotalProjects" Text="0" FontFamily="{StaticResource MainFont}" FontSize="42" FontWeight="Bold" Foreground="{StaticResource BrandBlue}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Documents" FontFamily="{StaticResource MainFont}" FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="txtTotalDocuments" Text="0" FontFamily="{StaticResource MainFont}" FontSize="42" FontWeight="Bold" Foreground="{StaticResource BrandGreen}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Active Projects" FontFamily="{StaticResource MainFont}" FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="txtActiveProjects" Text="0" FontFamily="{StaticResource MainFont}" FontSize="42" FontWeight="Bold" Foreground="#805AD5" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Row 2 Cards -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Pending Tasks" FontFamily="{StaticResource MainFont}" FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="txtPendingTasks" Text="0" FontFamily="{StaticResource MainFont}" FontSize="42" FontWeight="Bold" Foreground="{StaticResource BrandOrange}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Completed Tasks" FontFamily="{StaticResource MainFont}" FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="txtCompletedTasks" Text="0" FontFamily="{StaticResource MainFont}" FontSize="42" FontWeight="Bold" Foreground="#38A169" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Activity Section -->
            <Border Style="{StaticResource CardStyle}" Margin="12,24,12,12" MinHeight="300">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Recent Activity" FontFamily="{StaticResource MainFont}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <Button Content="Refresh Dashboard" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource BrandBlue}" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Click="BtnRefresh_Click"/>
                    </Grid>

                    <!-- We replace the hardcoded items with an ItemsControl bound to our DB -->
                    <ItemsControl x:Name="icRecentActivity">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ActivityItemStyle}">
                                    <Grid>
                                        <TextBlock Text="{Binding ActivityDescription}" FontFamily="{StaticResource MainFont}" FontSize="15" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,100,0"/>
                                        <TextBlock Text="{Binding FriendlyTime}" FontFamily="{StaticResource MainFont}" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="txtNoActivity" Text="No recent activity found." Foreground="{StaticResource TextSecondary}" FontStyle="Italic" Visibility="Collapsed" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>