<Window x:Class="SmartEngineeringWorkspaceManager.Pages.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Smart Engineering Workspace Manager" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource MainBg}">

    <Border Style="{DynamicResource StandardCardStyle}" Margin="40" Padding="30">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Smart Engineering" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,0"/>
            <TextBlock Text="Workspace Manager" Style="{StaticResource SubHeaderTextStyle}" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Username" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsername" FontSize="14" />

            <TextBlock Text="Password" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
            <!-- Since common style targets TextBox only, we manually align password borders here -->
            <PasswordBox x:Name="txtPassword" FontSize="14" Padding="8" Margin="0,5,0,25" Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}"/>

            <Button x:Name="btnLogin" Content="LOGIN" Style="{StaticResource PrimaryButtonStyle}" Click="BtnLogin_Click"/>

            <TextBlock x:Name="txtError" Text="Invalid Username or Password" Foreground="{DynamicResource DangerRed}" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>

        </StackPanel>
    </Border>

</Window>