<UserControl x:Class="SmartEngineeringWorkspaceManager.Pages.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950" Background="#F4F5F7">

    <UserControl.Resources>
        <FontFamily x:Key="MainFont">Segoe UI, Helvetica Neue, Arial</FontFamily>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3182CE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B6CB0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Form Panel -->
            <ColumnDefinition Width="320"/>
            <!-- Data Panel -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Form Panel -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="FormTitle" Text="Create New Task" FontSize="18" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,20" FontFamily="{StaticResource MainFont}"/>

                    <TextBlock Text="Task Name *" Foreground="#718096" Margin="0,0,0,5" FontFamily="{StaticResource MainFont}"/>
                    <TextBox x:Name="txtTaskName" Style="{StaticResource InputStyle}" Margin="0,0,0,15"/>

                    <TextBlock Text="Target Project *" Foreground="#718096" Margin="0,0,0,5" FontFamily="{StaticResource MainFont}"/>
                    <ComboBox x:Name="cbProjects" Margin="0,0,0,15" Padding="5" DisplayMemberPath="ProjectName" SelectedValuePath="ProjectId"/>

                    <TextBlock Text="Deadline *" Foreground="#718096" Margin="0,0,0,5" FontFamily="{StaticResource MainFont}"/>
                    <DatePicker x:Name="dpDeadline" Margin="0,0,0,15"/>

                    <TextBlock Text="Status" Foreground="#718096" Margin="0,0,0,5" FontFamily="{StaticResource MainFont}"/>
                    <ComboBox x:Name="cbStatus" Margin="0,0,0,15" Padding="5">
                        <ComboBoxItem Content="Pending" IsSelected="True"/>
                        <ComboBoxItem Content="In Progress"/>
                        <ComboBoxItem Content="In Review"/>
                        <ComboBoxItem Content="Completed"/>
                    </ComboBox>

                    <TextBlock Text="Task Description" Foreground="#718096" Margin="0,0,0,5" FontFamily="{StaticResource MainFont}"/>
                    <TextBox x:Name="txtDescription" Style="{StaticResource InputStyle}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnClear" Content="Clear" Background="#E2E8F0" Foreground="#2D3748" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="BtnClear_Click"/>
                        <Button x:Name="btnSave" Content="Save Task" Style="{StaticResource ActionButtonStyle}" Click="BtnSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right DataGrid Panel -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Status Board Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Task Board" FontSize="20" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center" FontFamily="{StaticResource MainFont}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox x:Name="txtSearch" Width="200" Style="{StaticResource InputStyle}" Text="Search tasks..." Foreground="#A0AEC0" GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus" TextChanged="TxtSearch_TextChanged" Margin="0,0,10,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- DataGrid -->
            <DataGrid x:Name="dgTasks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                      BorderBrush="#E2E8F0" BorderThickness="1" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionChanged="DgTasks_SelectionChanged">

                <!-- Configure row colors based on deadline proximity/status -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter Property="Foreground" Value="Gray"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Priority" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Task Name" Binding="{Binding TaskName}" Width="*"/>
                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="120"/>
                    <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline, StringFormat=d}" Width="90"/>
                    <DataGridTextColumn Header="Assigned To" Binding="{Binding AssignedToName}" Width="120"/>

                    <!-- Actions Column -->
                    <DataGridTemplateColumn Header="Actions" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Complete" ToolTip="Mark as Completed" Background="#38A169" Foreground="White" BorderThickness="0" Padding="8,5" Margin="0,0,5,0" Cursor="Hand" Click="BtnComplete_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <!-- Hide the Complete button if it's already done -->
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="Delete" Background="#E53E3E" Foreground="White" BorderThickness="0" Padding="8,5" Cursor="Hand" Click="BtnDelete_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>