<UserControl x:Class="SmartEngineeringWorkspaceManager.Pages.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950" 
             Style="{StaticResource FadeInPageStyle}"
             Background="{DynamicResource MainBg}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Form Panel -->
            <ColumnDefinition Width="340"/>
            <!-- Data Panel -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Form Panel -->
        <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}" Margin="12,12,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="FormTitle" Text="Create New Task" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,24"/>

                    <TextBlock Text="Task Name *" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtTaskName"/>

                    <TextBlock Text="Target Project *" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cbProjects" DisplayMemberPath="ProjectName" SelectedValuePath="ProjectId"/>

                    <TextBlock Text="Deadline *" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dpDeadline" Margin="0,4,0,16"/>

                    <TextBlock Text="Status" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cbStatus">
                        <ComboBoxItem Content="Pending" IsSelected="True"/>
                        <ComboBoxItem Content="In Progress"/>
                        <ComboBoxItem Content="In Review"/>
                        <ComboBoxItem Content="Completed"/>
                    </ComboBox>

                    <TextBlock Text="Task Description" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtDescription" Height="100" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="btnClear" Content="Clear" Style="{StaticResource PrimaryButtonStyle}" Background="Transparent" Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" Click="BtnClear_Click"/>
                        <Button x:Name="btnSave" Content="Save Task" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right DataGrid Panel -->
        <Border Grid.Column="1" Style="{StaticResource StandardCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status Board Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Task Board" Style="{StaticResource HeaderTextStyle}" Margin="0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBox x:Name="txtSearch" Width="220" Text="Search tasks..." Foreground="{DynamicResource TextSecondary}" GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus" TextChanged="TxtSearch_TextChanged" Margin="0"/>
                    </StackPanel>
                </Grid>

                <!-- DataGrid -->
                <DataGrid x:Name="dgTasks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgTasks_SelectionChanged">

                    <!-- Configure row colors based on deadline proximity/status -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Priority" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Task Name" Binding="{Binding TaskName}" Width="*"/>
                        <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="120"/>
                        <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline, StringFormat=d}" Width="90"/>
                        <DataGridTextColumn Header="Assigned To" Binding="{Binding AssignedToName}" Width="120"/>

                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="Actions" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Complete" ToolTip="Mark as Completed" Background="{DynamicResource BrandGreen}" Padding="10,6" Margin="0,0,5,0" Click="BtnComplete_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                    <Style.Triggers>
                                                        <!-- Hide the Complete button if it's already done -->
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="Delete" Style="{StaticResource PrimaryButtonStyle}" Background="{DynamicResource DangerRed}" Padding="10,6" Click="BtnDelete_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>