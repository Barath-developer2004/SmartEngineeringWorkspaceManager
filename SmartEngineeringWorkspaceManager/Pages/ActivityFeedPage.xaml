<Page x:Class="SmartEngineeringWorkspaceManager.Pages.ActivityFeedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded"
      Title="Activity &amp; Notifications">

    <Grid Background="{DynamicResource MainBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Notifications Column -->
        <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="8" Margin="10" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock Text="My Notifications" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15" DockPanel.Dock="Top"/>

                <ScrollViewer>
                    <ItemsControl x:Name="icNotifications">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding IsRead, Converter={StaticResource UnreadColorConverter}}" 
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="10" Margin="0,0,0,5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource BrandBlue}"/>
                                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,5,0,5"/>
                                        <DockPanel>
                                            <TextBlock Text="{Binding CreatedDate, StringFormat='g'}" FontSize="11" Foreground="{DynamicResource TextSecondary}" DockPanel.Dock="Left"/>
                                            <Button Content="Mark Read" CommandParameter="{Binding NotificationId}" 
                                                    Click="BtnMarkRead_Click" 
                                                    HorizontalAlignment="Right" DockPanel.Dock="Right"
                                                    Visibility="{Binding IsRead, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Global Activity Log Column -->
        <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="8" Margin="10" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock Text="Recent System Activity" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15" DockPanel.Dock="Top"/>

                <DataGrid x:Name="dgActivityLogs" AutoGenerateColumns="False" IsReadOnly="True" 
                          CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" 
                          BorderBrush="Transparent" RowBackground="{DynamicResource CardBg}" AlternatingRowBackground="{DynamicResource MainBg}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding ActivityDate, StringFormat='g'}" Width="150" />
                        <DataGridTextColumn Header="Type" Binding="{Binding ActivityType}" Width="120" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Page>