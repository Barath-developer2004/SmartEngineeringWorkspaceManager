<Window x:Class="SmartEngineeringWorkspaceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartEngineeringWorkspaceManager"
        mc:Ignorable="d"
        Title="Smart Engineering Workspace Manager" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Window.Resources>
        <!-- Modern Fonts -->
        <FontFamily x:Key="MainFont">Segoe UI, Helvetica Neue, Arial</FontFamily>

        <!-- Color Palette -->
        <SolidColorBrush x:Key="SidebarBg" Color="#1E1E2F"/>
        <SolidColorBrush x:Key="SidebarHover" Color="#2A2A40"/>
        <SolidColorBrush x:Key="SidebarActive" Color="#3D3D5C"/>
        <SolidColorBrush x:Key="SidebarText" Color="#A0A0B0"/>
        <SolidColorBrush x:Key="SidebarTextHover" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="MainBg" Color="#F4F5F7"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="TextPrimary" Color="#2D3748"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#718096"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>

        <SolidColorBrush x:Key="BrandBlue" Color="#3182CE"/>
        <SolidColorBrush x:Key="BrandOrange" Color="#DD6B20"/>
        <SolidColorBrush x:Key="BrandGreen" Color="#38A169"/>

        <!-- Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SidebarText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="25,16"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover Effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SidebarHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource SidebarTextHover}"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" BlurRadius="5" Opacity="0.1" ShadowDepth="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Navigation Button Style (Inherits from NavButtonStyle) -->
        <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SidebarActive}"/>
            <Setter Property="Foreground" Value="{StaticResource SidebarTextHover}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Dashboard Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#A0AEC0" BlurRadius="15" Opacity="0.15" ShadowDepth="4" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Activity List Item Border Style -->
        <Style x:Key="ActivityItemStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,16"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource MainBg}">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="250" />
            <!-- Main Content -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 1. Left Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <StackPanel>
                <!-- Application Title -->
                <TextBlock Text="Smart Eng. Workspace" 
                           Foreground="{StaticResource SidebarTextHover}" 
                           FontFamily="{StaticResource MainFont}"
                           FontSize="22" 
                           FontWeight="Bold" 
                           Margin="24,36,24,48"
                           TextWrapping="Wrap"/>

                <!-- Navigation Buttons -->
                <Button x:Name="BtnDashboard" Content="Dashboard" Style="{StaticResource ActiveNavButtonStyle}" Click="NavButton_Click"/>
                <Button x:Name="BtnActivity" Content="Activity &amp; Notifications" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click"/>
                <Button x:Name="BtnProjects" Content="Projects" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click"/>
                <Button x:Name="BtnDocuments" Content="Documents" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click"/>
                <Button x:Name="BtnTasks" Content="Tasks" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click"/>
                <Button x:Name="BtnReports" Content="Reports" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click"/>
                <Button x:Name="BtnSettings" Content="Settings" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Area (Header + Dashboard Content) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="90"/>
                <!-- Dynamic Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 2. Top Header -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                <Grid Margin="36,0">
                    <TextBlock x:Name="HeaderTitle"
                               Text="Dashboard Overview" 
                               FontFamily="{StaticResource MainFont}"
                               VerticalAlignment="Center" 
                               FontSize="26" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimary}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#E2E8F0" CornerRadius="20" Width="40" Height="40" Margin="0,0,12,0">
                            <TextBlock x:Name="txtUserInitial" Text="U" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="txtWelcomeUser" Text="Welcome, User" 
                                   FontFamily="{StaticResource MainFont}"
                                   VerticalAlignment="Center" 
                                   FontSize="15" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,0,20,0"/>
                        <Button x:Name="BtnSignOut" Content="Sign Out" VerticalAlignment="Center" Padding="15,6" Background="Transparent" Foreground="{StaticResource DangerRed}" BorderBrush="{StaticResource DangerRed}" BorderThickness="1" Click="BtnSignOut_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Main Content Area (Dynamic Content loaded here) -->
            <!-- We add a Frame and ContentControl both to handle Pages and UserControls respectfully based on how the old app did it -->
            <Grid Grid.Row="1">
                 <ContentControl x:Name="MainContent" Panel.ZIndex="1"/>
                 <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Panel.ZIndex="2"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
