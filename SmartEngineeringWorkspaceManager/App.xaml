<Application x:Class="SmartEngineeringWorkspaceManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmartEngineeringWorkspaceManager"
             StartupUri="Pages\LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Default Theme loaded on startup -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <!-- UI Controls & Typography logic -->
                <ResourceDictionary Source="Themes/CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
